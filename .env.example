# Copiar a .env y completar. .env está en .gitignore: NUNCA commitearlo.

# RPC de Sepolia (Alchemy, Infura, etc.)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/TU_API_KEY

# Private key de una wallet SOLO de testnet (con 0x). Nunca la de una wallet con fondos reales.
PRIVATE_KEY=0xTU_PRIVATE_KEY_DE_TESTNET

# API key de Etherscan (sirve para verificar en Sepolia)
ETHERSCAN_API_KEY=TU_ETHERSCAN_API_KEY

# Segunda wallet de testnet, SOLO para script/Demo.s.sol (simula al segundo miembro de la ronda).
# Necesita un poco de Sepolia ETH para gas.
PRIVATE_KEY_2=0xPRIVATE_KEY_DE_OTRA_WALLET_DE_TESTNET

# ── Chainlink VRF v2.5 (sorteo del orden de cobro) ──────────────────────────────────────────────
# Id de la suscripción creada en https://vrf.chain.link (red Sepolia) con la MISMA wallet de PRIVATE_KEY,
# fondeada con LINK de testnet (https://faucets.chain.link/sepolia). Deploy agrega la factory como consumidor.
VRF_SUBSCRIPTION_ID=0
# false = la suscripción paga en LINK (recomendado); true = paga en ETH de Sepolia
VRF_NATIVE_PAYMENT=false
# Opcionales: por defecto se usan los valores oficiales de Sepolia (docs.chain.link/vrf/v2-5/supported-networks)
# VRF_COORDINATOR=0x9DdfaCa8183c41ad55329BdeeD9F6A8d53168B1B
# VRF_KEY_HASH=0x787d74caea10b2b357790d5b5247c2f63d1d91572a9846f780606e4d953677ae
