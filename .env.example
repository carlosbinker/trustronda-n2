# Copiar a .env y completar. .env está en .gitignore: NUNCA commitearlo.

# RPC de Sepolia (Alchemy, Infura, etc.)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/TU_API_KEY

# Private key de una wallet SOLO de testnet (con 0x). Nunca la de una wallet con fondos reales.
PRIVATE_KEY=0xTU_PRIVATE_KEY_DE_TESTNET

# API key de Etherscan (sirve para verificar en Sepolia)
ETHERSCAN_API_KEY=TU_ETHERSCAN_API_KEY
