# Copiar a .env.local (no se commitea). Las direcciones las imprime `make deploy` y quedan en deployments/11155111.json
VITE_CHAIN_ID=11155111
VITE_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
VITE_USDC_ADDRESS=0x0000000000000000000000000000000000000000
# Bloque del deploy (deployments/11155111.json -> deployBlock): desde ahí se buscan los eventos
VITE_DEPLOY_BLOCK=0
# RPC para lecturas (opcional; vacío = RPC por defecto de viem). Recomendado: un RPC público SIN clave, porque
# todo lo que empieza con VITE_ queda dentro del JavaScript que descarga el navegador. Las transacciones van por MetaMask.
VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
